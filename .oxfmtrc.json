{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"tabWidth": 4,
	"singleQuote": true,
	"jsxSingleQuote": true,
	"useTabs": true,
	"semi": true,
	"printWidth": 130,
	"trailingComma": "es5",
	"endOfLine": "lf",
	"insertFinalNewline": true,
	"sortPackageJson": true,
	"quoteProps": "as-needed",
	"bracketSpacing": true,
	"bracketSameLine": false,
	"arrowParens": "always",
	"singleAttributePerLine": false,
	"ignorePatterns": ["main.js", "pnpm-lock.yaml", ".github/**", ".vscode/**"]
}
