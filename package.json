{
	"name": "obsidian-depot",
	"version": "0.1.0",
	"private": true,
	"description": "S3-compatible attachment storage with private buckets and persistent references.",
	"keywords": [],
	"license": "0-BSD",
	"author": "Mathieu Céraline <oss@mathcrln.com>",
	"type": "module",
	"main": "main.js",
	"scripts": {
		"build": "pnpm typecheck && node esbuild.config.mjs production",
		"dev": "node esbuild.config.mjs",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "eslint .",
		"test": "vitest",
		"test:run": "vitest run",
		"typecheck": "tsc --noEmit && tsc -p tests",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"dependencies": {
		"aws4fetch": "1.0.20"
	},
	"devDependencies": {
		"@types/node": "26.6.5",
		"esbuild": "0.28.2",
		"eslint": "10.13.0",
		"eslint-plugin-obsidianmd": "0.4.2",
		"fake-indexeddb": "6.2.6",
		"obsidian": "1.14.4",
		"oxfmt": "0.75.0",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	}
}
